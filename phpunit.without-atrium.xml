<?xml version="1.0" encoding="UTF-8"?>
<!--
    Keen without Atrium: `composer test:without-atrium`. The bootstrap removes
    Atrium from the autoloader, so this suite must never run with an optimized
    or authoritative classmap. The `without-atrium` CI job, which uninstalls
    Atrium, is the authoritative proof.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    backupGlobals="false"
    bootstrap="tests/WithoutAtrium/bootstrap.php"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    executionOrder="default"
    failOnWarning="true"
    failOnRisky="true"
    failOnEmptyTestSuite="true"
    beStrictAboutOutputDuringTests="true"
    cacheDirectory=".phpunit.cache/without-atrium"
    backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="WithoutAtrium">
            <directory>tests/WithoutAtrium</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
